{
  "name": "anxin-app",
  "private": true,
  "version": "0.0.1",
  "packageManager": "pnpm@11.5.0",
  "main": "expo-router/entry",
  "engines": {
    "node": ">=22",
    "pnpm": ">=11"
  },
  "scripts": {
    "prepare": "husky",
    "start": "expo start",
    "build:android": "expo run:android",
    "build:ios": "expo run:ios",
    "test": "jest",
    "design": "python3 scripts/render_current_app_screens.py",
    "thumbs": "node scripts/capture_runtime_thumbs.js",
    "skin:package": "node scripts/skin_package_tool.js",
    "skin:qa:remote": "jest tests/skin/remote-download-qa.test.ts --runInBand",
    "check:type": "tsc --noEmit",
    "check:local": "node scripts/check-locals.js",
    "check:qa": "node scripts/check_qa.js",
    "check:qa:runtime": "pnpm thumbs",
    "check:qa:all": "node scripts/check_qa.js --include-runtime",
    "fix:all": "pnpm fix:eslint && pnpm fix:prettier",
    "fix:prettier": "prettier --config ./.prettierrc --write .",
    "fix:eslint": "eslint --config ./eslint.config.js --fix --quiet --no-warn-ignored ."
  },
  "dependencies": {
    "@expo/metro-runtime": "^55",
    "@expo/ui": "^55",
    "@react-native-async-storage/async-storage": "2.2.0",
    "css-to-react-native": "3.2.0",
    "expo": "^55",
    "expo-document-picker": "~55.0.13",
    "expo-file-system": "^55",
    "expo-router": "^55",
    "expo-sharing": "~55.0.20",
    "expo-status-bar": "^55",
    "nativewind": "^4.2.3",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-hook-form": "^7",
    "react-native": "0.83.6",
    "react-native-css-interop": "0.2.4",
    "react-native-reanimated": "4.2.1",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-web": "^0.21",
    "react-native-worklets": "0.7.4",
    "styled-components": "^6",
    "zod": "^4",
    "zustand": "^5"
  },
  "devDependencies": {
    "@expo/cli": "^55",
    "@playwright/test": "^1.59.1",
    "@react-native/jest-preset": "0.85.3",
    "@testing-library/react-native": "^13",
    "@types/jest": "^29.5.14",
    "@types/node": "^25",
    "@types/react": "^19",
    "babel-plugin-styled-components": "^2",
    "babel-preset-expo": "^55",
    "eslint": "^9",
    "eslint-config-jshow": "latest",
    "eslint-config-prettier": "latest",
    "eslint-plugin-jshow": "latest",
    "eslint-plugin-prettier": "latest",
    "husky": "latest",
    "jest": "^29.7.0",
    "jest-expo": "^55",
    "lint-staged": "latest",
    "prettier": ">=3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "react-test-renderer": "19.2.0",
    "tailwindcss": "3.4.17",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8"
  },
  "lint-staged": {
    "*.{md,json}": [
      "prettier --config ./.prettierrc --write"
    ],
    "*.{ts,js,tsx,jsx,vue}": [
      "prettier --config ./.prettierrc --write",
      "eslint --config ./eslint.config.js --fix --quiet --no-warn-ignored"
    ]
  }
}
